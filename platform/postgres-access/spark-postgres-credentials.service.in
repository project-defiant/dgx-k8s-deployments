# Managed by TheDefiant postgres-service.sh
[Unit]
Description=Refresh scoped Postgres forwarding credentials
Wants=k3s.service
After=k3s.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I /etc/spark-postgres-access/refresh-credentials.py
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spark-postgres-access
UMask=0077
