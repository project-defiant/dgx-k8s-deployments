apiVersion: v1
kind: ServiceAccount
metadata:
  name: docs-forwarder
  namespace: docs-@ENV@
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: docs-forwarder
  namespace: docs-@ENV@
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]
  - apiGroups: [""]
    resources: ["services"]
    resourceNames: ["docs"]
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["pods/portforward"]
    # WebSocket GET plus the Kubernetes 1.35 synthetic CREATE authorization check.
    # https://www.kubernetes.dev/resources/keps/4006/
    verbs: ["get", "create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: docs-forwarder
  namespace: docs-@ENV@
subjects:
  - kind: ServiceAccount
    name: docs-forwarder
    namespace: docs-@ENV@
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: docs-forwarder
